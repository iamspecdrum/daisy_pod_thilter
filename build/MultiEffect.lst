  49:MultiEffect.cpp **** 
  50:MultiEffect.cpp ****     //audio
  51:MultiEffect.cpp ****     for(size_t i = 0; i < size; i += 2)
  52:MultiEffect.cpp ****     {
  53:MultiEffect.cpp ****         inl = in[i];
