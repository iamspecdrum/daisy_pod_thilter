  73:threeEQ.h     **** class L_Riley_HP
  74:threeEQ.h     **** {
  75:threeEQ.h     **** 
  76:threeEQ.h     **** public:
  77:threeEQ.h     ****     L_Riley_HP():
  78:threeEQ.h     ****     fc(750.0),
  79:threeEQ.h     ****     sampleRate(44100.0)
  80:threeEQ.h     ****     {
  81:threeEQ.h     ****         wc=2*PI*fc;
  82:threeEQ.h     ****         wc2=wc*wc;
  83:threeEQ.h     ****         wc3=wc2*wc;
  84:threeEQ.h     ****         wc4=wc2*wc2;
  85:threeEQ.h     ****         k=wc/tan(PI*fc/sampleRate);
  86:threeEQ.h     ****         k2=k*k;
  87:threeEQ.h     ****         k3=k2*k;
  88:threeEQ.h     ****         k4=k2*k2;
  89:threeEQ.h     ****         sqrt2=sqrt(2);
  90:threeEQ.h     ****         sq_tmp1=sqrt2*wc3*k;
  91:threeEQ.h     ****         sq_tmp2=sqrt2*wc*k3;
  92:threeEQ.h     ****         a_tmp=4*wc2*k2+2*sq_tmp1+k4+2*sq_tmp2+wc4;
  93:threeEQ.h     ****         b1=(4*(wc4+sq_tmp1-k4-sq_tmp2))/a_tmp;
  94:threeEQ.h     ****         b2=(6*wc4-8*wc2*k2+6*k4)/a_tmp;
  95:threeEQ.h     ****         b3=(4*(wc4-sq_tmp1+sq_tmp2-k4))/a_tmp;
  96:threeEQ.h     ****         b4=(k4-2*sq_tmp1+wc4-2*sq_tmp2+4*wc2*k2)/a_tmp;
  97:threeEQ.h     ****     }
  98:threeEQ.h     ****     void setSampleRate(float sr){
  99:threeEQ.h     ****         sampleRate=sr;
 100:threeEQ.h     ****     }
 101:threeEQ.h     **** 
 102:threeEQ.h     ****     float process(float inputValue){
 103:threeEQ.h     ****         a0=k4/a_tmp;
 104:threeEQ.h     ****         a1=-4*k4/a_tmp;
 105:threeEQ.h     ****         a2=6*k4/a_tmp;
 106:threeEQ.h     ****         a3=a1;
 107:threeEQ.h     ****         a4=a0;
 108:threeEQ.h     ****         tempx=inputValue;
 109:threeEQ.h     **** 
 110:threeEQ.h     ****         tempy=a0*tempx+a1*xm1+a2*xm2+a3*xm3+a4*xm4-b1*ym1-b2*ym2-b3*ym3-b4*ym4;
 111:threeEQ.h     ****         xm4=xm3;
 112:threeEQ.h     ****         xm3=xm2;
 113:threeEQ.h     ****         xm2=xm1;
 114:threeEQ.h     ****         xm1=tempx;
 115:threeEQ.h     ****         ym4=ym3;
 116:threeEQ.h     ****         ym3=ym2;
 117:threeEQ.h     ****         ym2=ym1;
 118:threeEQ.h     ****         ym1=tempy;
 119:threeEQ.h     **** 
 120:threeEQ.h     ****         return tempy;
 121:threeEQ.h     ****     }
 122:threeEQ.h     ****     void set(float newCutoff){
 123:threeEQ.h     ****         fc = newCutoff;
 124:threeEQ.h     ****     };
 125:threeEQ.h     **** private:
 126:threeEQ.h     ****     float sampleRate;
 127:threeEQ.h     ****     float fc = 0.0f;
 128:threeEQ.h     ****     float sqrt2;
ARM GAS  /var/folders/xb/zvg9v0g14pd60b0jj8l41p600000gn/T//cclxw5tJ.s 			page 25


