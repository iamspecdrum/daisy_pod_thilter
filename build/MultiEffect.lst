 333:threeEQ.h     ****   
 334:threeEQ.h     ****   void runStats(float* left, float*right, int length) {
 335:threeEQ.h     ****     for (int i=0; i<length; i++){
 336:threeEQ.h     ****       m = midHP.process(midLP.process(mid(left[i], right[i])));
 337:threeEQ.h     ****       l = leftHP.process(leftOnly(left[i], right[i]));
 338:threeEQ.h     ****       r = rightHP.process(rightOnly(left[i], right[i]));
 339:threeEQ.h     ****       midh = midHPH.process(m);
 340:threeEQ.h     ****       midm = midHPM.process(midLPM.process(m));
 341:threeEQ.h     ****       midl = midLPL.process((m));
 342:threeEQ.h     ****       lefth = leftHPH.process(l);
 343:threeEQ.h     ****       leftm = leftHPM.process(leftLPM1.process(l));
 344:threeEQ.h     ****       leftl = leftLPL.process((l));
 345:threeEQ.h     ****       righth = rightHPH.process(r);
 346:threeEQ.h     ****       rightm = rightHPM.process(rightLPM1.process(r));
 347:threeEQ.h     ****       rightl = rightLPL.process((r));
ARM GAS  /var/folders/xb/zvg9v0g14pd60b0jj8l41p600000gn/T//cclxw5tJ.s 			page 89


 348:threeEQ.h     ****       sidehighrms += (abs(lefth)+abs(righth)) / (2.0*length);
 349:threeEQ.h     ****       sidemidrms += (abs(leftm)+abs(rightm)) / (2.0*length);
 350:threeEQ.h     ****       sidelowrms += (abs(leftl)+abs(rightl)) / (2.0*length);
 351:threeEQ.h     ****       midhighrms += (abs(midh) / length);
 352:threeEQ.h     ****       midmidrms += (abs(midm) / length);
 353:threeEQ.h     ****       midlowrms += (abs(midl) / length);
 354:threeEQ.h     ****       maximum = std::fmax(std::fabs(left[i]),std::fabs(right[i]));
 355:threeEQ.h     ****     }
 356:threeEQ.h     ****     for (int i = 0; i < length; i++) {
 357:threeEQ.h     ****       sidehighsd += abs(abs(lefth) + abs(righth) - (2 * sidehighrms)) / (2.0*length);
 358:threeEQ.h     ****       sidemidsd += abs(abs(leftm) + abs(rightm) - (2 * sidemidrms)) / (2.0*length);
 359:threeEQ.h     ****       sidelowsd += abs(abs(leftl) + abs(rightl) - (2 * sidelowrms)) / (2.0*length);
 360:threeEQ.h     ****       midhighsd += abs(abs(midh) - sidehighrms) / length;
 361:threeEQ.h     ****       midmidsd += abs(abs(midm) - midmidrms) / length;
 362:threeEQ.h     ****       midlowsd += abs(abs(midl) - midlowrms) / length;
 363:threeEQ.h     ****     };
 364:threeEQ.h     ****   };
 365:threeEQ.h     ****   void setGoals(float gmhrms, float gmmrms, float gmlrms, float gshrms, float gsmrms, float gslrms,
 366:threeEQ.h     ****     
 367:threeEQ.h     ****     midhighrms = gmhrms;
 368:threeEQ.h     ****     midmidrms = gmmrms;
 369:threeEQ.h     ****     midlowrms = gmlrms;
 370:threeEQ.h     ****     sidehighrms = gshrms;
 371:threeEQ.h     ****     sidemidrms = gsmrms;
 372:threeEQ.h     ****     sidelowrms = gslrms;
 373:threeEQ.h     ****     midhighsd = gmhsd;
 374:threeEQ.h     ****     midmidsd = gmmsd;
 375:threeEQ.h     ****     midlowsd = gmlsd;
 376:threeEQ.h     ****     sidehighsd = gshsd;
 377:threeEQ.h     ****     sidemidsd = gsmsd;
 378:threeEQ.h     ****     sidelowsd = gslsd;
 379:threeEQ.h     ****     
 380:threeEQ.h     ****   }
 381:threeEQ.h     ****   float* match(float left, float right) {
 382:threeEQ.h     ****     l = leftHP.process(leftOnly(left, right));
 383:threeEQ.h     ****     m = midHP.process(midLP.process(mid(left, right)));
 384:threeEQ.h     ****     r = rightHP.process(rightOnly(left, right));
 385:threeEQ.h     ****     
 386:threeEQ.h     ****     lefth = leftHPH.process(l);
 387:threeEQ.h     ****     leftm = leftHPM.process(leftLPM1.process(l));
 388:threeEQ.h     ****     leftl = leftLPL.process(l);
 389:threeEQ.h     ****     midh = midHPH.process(m);
 390:threeEQ.h     ****     midm = midHPM.process(midLPM.process(m));
 391:threeEQ.h     ****     midl = midLPL.process(m);
 392:threeEQ.h     ****     righth = rightHPH.process(r);
 393:threeEQ.h     ****     rightm = rightHPM.process(rightLPM1.process(r));
 394:threeEQ.h     ****     rightl = rightLPL.process(r);
 395:threeEQ.h     ****     
 396:threeEQ.h     ****     if(index<8){
 397:threeEQ.h     ****       processlefthigh[index] = lefth;
