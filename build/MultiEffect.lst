  29:limiter.h     ****     float process(float inputValue)
  30:limiter.h     ****     {
  31:limiter.h     ****         float inputAbs = fabsf(inputValue);
  32:limiter.h     **** 
  33:limiter.h     ****         if(inputAbs > env)
  34:limiter.h     ****             env += attack * (inputAbs - env);
  35:limiter.h     ****         else
  36:limiter.h     ****             env += release * (inputAbs - env);
  37:limiter.h     **** 
  38:limiter.h     ****         float targetGain = 1.0f;
  39:limiter.h     ****         if(env > threshold)
  40:limiter.h     ****             targetGain = threshold / env;
  41:limiter.h     **** 
  42:limiter.h     ****         if(targetGain < 0.0f)
  43:limiter.h     ****             targetGain = 0.0f;
  44:limiter.h     **** 
  45:limiter.h     ****         if(targetGain > gain)
  46:limiter.h     ****             gain += attack * (targetGain - gain);
  47:limiter.h     ****         else
  48:limiter.h     ****             gain += release * (targetGain - gain);
  49:limiter.h     **** 
  50:limiter.h     ****         float output = inputValue * gain;
  51:limiter.h     **** 
  52:limiter.h     ****         // Soft clip to keep peaks from overshooting after gain reduction.
  53:limiter.h     ****         if(output > 1.0f)
  54:limiter.h     ****             output = 1.0f - expf(-output);
  55:limiter.h     ****         else if(output < -1.0f)
  56:limiter.h     ****             output = -1.0f + expf(output);
  57:limiter.h     **** 
  58:limiter.h     ****         return output;
  59:limiter.h     ****     }
