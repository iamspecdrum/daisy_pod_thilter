  45:doubler.h     ****     float process(float inputValue)
  46:doubler.h     ****     {
  47:doubler.h     ****         if(delaySamples < 1)
  48:doubler.h     ****             updateDelay();
  49:doubler.h     **** 
  50:doubler.h     ****         const int readIndex = (writeIndex + (kMaxDelaySamples - delaySamples))
  51:doubler.h     ****                               % kMaxDelaySamples;
  52:doubler.h     ****         const int readIndexAlt
  53:doubler.h     ****             = (writeIndexAlt + (kMaxDelaySamples - delaySamplesAlt))
  54:doubler.h     ****               % kMaxDelaySamples;
  55:doubler.h     **** 
  56:doubler.h     ****         const float delayed0 = buffer[readIndex];
  57:doubler.h     ****         const float delayed1 = bufferAlt[readIndexAlt];
  58:doubler.h     **** 
  59:doubler.h     ****         const float wet = (delayed0 * 0.55f) + (delayed1 * 0.45f);
  60:doubler.h     ****         const float output = (inputValue * dryMix) + (wet * wetMix);
  61:doubler.h     **** 
  62:doubler.h     ****         buffer[writeIndex] = inputValue + (feedback * delayed0);
  63:doubler.h     ****         bufferAlt[writeIndexAlt] = inputValue + (feedback * delayed1);
  64:doubler.h     **** 
  65:doubler.h     ****         writeIndex = (writeIndex + 1) % kMaxDelaySamples;
  66:doubler.h     ****         writeIndexAlt = (writeIndexAlt + 1) % kMaxDelaySamples;
  67:doubler.h     **** 
  68:doubler.h     ****         return output;
  69:doubler.h     ****     }
