  63:threeEQ.h     ****     float a0 = 0.0f, a1 = 0.0f, a2 = 0.0f, a3 = 0.0f, a4 = 0.0f;
  64:threeEQ.h     ****     float b1 = 0.0f, b2 = 0.0f, b3 = 0.0f, b4 = 0.0f;
  65:threeEQ.h     ****     float tempx = 0.0f;
  66:threeEQ.h     ****     float tempy = 0.0f;
  67:threeEQ.h     ****     float xm1 = 0.0f;
  68:threeEQ.h     ****     float xm2 = 0.0f;
  69:threeEQ.h     ****     float xm3 = 0.0f;
  70:threeEQ.h     ****     float xm4 = 0.0f;
